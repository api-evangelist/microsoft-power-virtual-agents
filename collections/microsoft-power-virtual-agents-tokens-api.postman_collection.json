          "name": "Generate a Direct Line token from a Direct Line secret",
          "request": {
            "name": "Generate a Direct Line token from a Direct Line secret",
            "description": {
              "content": "Exchanges a Direct Line secret for a short-lived token. For Copilot Studio agents the token is normally obtained by issuing a GET to the agent-specific token endpoint shown on the Mobile app channel page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "directline",
                "tokens",
                "generate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "db81e452-b195-4d07-bb41-69e6b64b33b8",
              "name": "Direct Line token",
              "originalRequest": {
                "url": {
                  "path": [
                    "v3",
                    "directline",
                    "tokens",
                    "generate"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
